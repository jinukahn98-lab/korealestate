{
  "name": "kr-realestate-worker",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "python3 ../tests/test_d1_export.py && ./scripts/test_d1_migrations.sh && npm run test:api",
    "test:api": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=test/.build/index.mjs --log-level=warning && node test/api-contract.mjs",
    "db:create": "wrangler d1 create kr-realestate",
    "db:migrate": "./scripts/apply_d1_migrations.sh local",
    "db:migrate:remote": "CONFIRM_REMOTE_D1=1 ./scripts/apply_d1_migrations.sh remote",
    "db:sync": "./scripts/sync_d1_data.sh local",
    "db:sync:remote": "CONFIRM_REMOTE_D1=1 ./scripts/sync_d1_data.sh remote",
    "db:seed": "wrangler d1 execute kr-realestate --file=seed.sql --remote",
    "db:seed-local": "wrangler d1 execute kr-realestate --file=seed.sql --local"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
